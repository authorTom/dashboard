# Dashboard — environment template.
#
# Copy this file to ".env" (same directory as compose.yaml) and edit as needed.
# Docker Compose reads a sibling ".env" automatically for ${...} interpolation.
# Real ".env" files are gitignored; only this template is tracked.
#
# Running without Docker? The same file works:
#   node --env-file=.env server.js

# ---- Required ---------------------------------------------------------------

# Password for the admin area. There is no default and no recovery — the app
# refuses to start without it. CHANGE THIS.
ADMIN_PASSWORD=changeme


# ---- Docker Compose ---------------------------------------------------------

# Host port to publish the app on (the container always listens on 8080).
DASHBOARD_PORT=8080

# Image to run. Default is the latest multi-arch build from GHCR.
# Pin an immutable tag for reproducible, rollback-friendly deploys, e.g.:
#   DASHBOARD_IMAGE=ghcr.io/authortom/dashboard:sha-fe1d50d
DASHBOARD_IMAGE=ghcr.io/authortom/dashboard:latest


# ---- Network ----------------------------------------------------------------

# Set to 1 when serving over HTTPS (behind a reverse proxy) so the session
# cookie is marked Secure.
SECURE_COOKIES=0

# Number of reverse proxies in front of this server. Leave unset when clients
# connect directly. Only set it if you really are behind a proxy: it makes the
# server believe X-Forwarded-For, which a direct client can forge to defeat the
# login rate limit.
# TRUST_PROXY=1


# ---- Running without Docker -------------------------------------------------
# Ignored by Compose; the container sets its own values for these.

# Port to listen on.
# PORT=3000

# Interface to bind. 127.0.0.1 = this machine only; 0.0.0.0 = reachable on your LAN.
# HOST=0.0.0.0

# Where links.json and the cached favicons are stored.
# DASHBOARD_DATA_DIR=data
